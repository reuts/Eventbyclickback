{
  "kind": "collectionType",
  "collectionName": "registers",
  "info": {
    "singularName": "register",
    "pluralName": "registers",
    "displayName": "register"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "inversedBy": "registers"
    },
    "name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profession": {
      "type": "string"
    },
    "newsletter": {
      "type": "boolean",
      "default": false
    },
    "extra_fields": {
      "type": "json"
    },
    "password": {
      "type": "password",
      "private": true,
      "searchable": false
    },
    "gender": {
      "type": "string"
    },
    "birthday": {
      "type": "date"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "profile": {
      "type": "string"
    },
    "accept_terms": {
      "type": "boolean"
    },
    "legacy_id": {
      "type": "integer",
      "private": true
    },
    "signed_up_at": {
      "type": "datetime"
    },
    "player_source": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player",
      "inversedBy": "registrants"
    }
  }
}
